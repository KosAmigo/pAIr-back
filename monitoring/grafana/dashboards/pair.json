{
 "uid": "pair-overview",
 "title": "pAIr 한눈에",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "요청 수 (초당)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "전체"
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "응답 시간 p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "JVM 힙 사용량",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "사용"
    },
    {
     "refId": "B",
     "expr": "max(sum by (instance) (jvm_memory_max_bytes{area=\"heap\"}))",
     "legendFormat": "최대"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "DB 커넥션 풀",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(hikaricp_connections_active)",
     "legendFormat": "사용 중"
    },
    {
     "refId": "B",
     "expr": "max(hikaricp_connections_max)",
     "legendFormat": "최대"
    },
    {
     "refId": "C",
     "expr": "sum(hikaricp_connections_pending)",
     "legendFormat": "대기"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "AI 토큰 (분당)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider,direction) (increase(pair_ai_tokens_total[5m])) / 5",
     "legendFormat": "{{provider}} {{direction}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "AI 호출 평균 시간 / 오류",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider) (rate(pair_ai_call_seconds_sum[5m])) / clamp_min(sum by (provider) (rate(pair_ai_call_seconds_count[5m])),0.0001)",
     "legendFormat": "{{provider}} 평균(초)"
    },
    {
     "refId": "B",
     "expr": "sum(rate(pair_ai_call_seconds_count{outcome=\"error\"}[5m]))",
     "legendFormat": "오류/초"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "샌드박스 동시 실행",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(pair_sandbox_running)",
     "legendFormat": "실행 중"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "샌드박스 거절 (5분)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(pair_sandbox_busy_total[5m]))",
     "legendFormat": "거절"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "채점 대기 건수",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(pair_grading_pending)",
     "legendFormat": "대기"
    }
   ]
  }
 ]
}