{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pair-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "gradlew.bat", "bootRun", "--console=plain"],
      "env": { "JAVA_TOOL_OPTIONS": "-Djdk.net.unixdomain.tmpdir=C:/dev/tmp" },
      "port": 8180,
      "autoPort": false
    },
    {
      "name": "pair-backend-docs-full",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "gradlew.bat", "bootRun", "--console=plain", "--args=--server.port=8181 --pair.judge.reference-docs=full"],
      "port": 8181,
      "autoPort": false
    },
    {
      "name": "pair-backend-docs-rag",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "gradlew.bat", "bootRun", "--console=plain", "--args=--server.port=8181 --pair.judge.reference-docs=rag"],
      "port": 8181,
      "autoPort": false
    }
  ]
}
